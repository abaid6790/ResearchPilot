# ResearchPilot AI - environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# ---- Core ------------------------------------------------------------
# FLASK_ENV: development | production | testing
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_BASE_URL=http://localhost:5000

# ---- Database (PostgreSQL) -------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://researchpilot:change-me@localhost:5432/researchpilot

# ---- Redis / Celery (used from Phase 7 onward) -----------------------
REDIS_URL=redis://localhost:6379/0

# ---- Email (SMTP) ----------------------------------------------------
# Local development tip: run Mailpit (SMTP localhost:1025, web UI :8025)
# and set MAIL_SERVER=localhost, MAIL_PORT=1025, MAIL_USE_TLS=false.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ---- LLM providers (Phase 3) -----------------------------------------
# Up to 8 keys per provider (_1 ... _8). Never commit real keys.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GROQ_API_KEY_1=
OPENROUTER_API_KEY_1=

# Fallback order (comma separated; remove a provider to disable it)
# LLM_PROVIDER_ORDER=gemini,groq,openrouter
# Gemini quotas are per Google Cloud project. Keys from the SAME project share quota, so tell
# the router by giving them the same label (default: every key is assumed to be its own project):
# GEMINI_API_KEY_1_PROJECT=my-project
# GEMINI_API_KEY_2_PROJECT=my-project
# Model overrides (defaults are in providers/models.py; verify with `flask llm-ping`)
# GEMINI_MODEL_QUALITY=
# GEMINI_MODEL_FAST=
# GROQ_MODEL_QUALITY=
# GROQ_MODEL_FAST=
# OPENROUTER_MODEL_QUALITY=
# OPENROUTER_MODEL_FAST=
# Tuning (defaults shown)
# LLM_REQUEST_TIMEOUT_S=60
# LLM_OVERALL_DEADLINE_S=180
# LLM_MAX_TOTAL_ATTEMPTS=8
# LLM_MAX_RETRIES_PER_KEY=2
# LLM_MAX_VALIDATION_RETRIES=1
# LLM_MAX_CONCURRENCY=8
# LLM_BACKOFF_BASE_S=0.5
# LLM_BACKOFF_CAP_S=8
# LLM_MAX_INLINE_WAIT_S=5
# LLM_RATE_LIMIT_COOLDOWN_S=30
# LLM_AUTH_COOLDOWN_S=21600
# Share key cooldowns between Gunicorn/Celery processes (needs REDIS_URL): memory | redis
# LLM_HEALTH_STORE=memory
# Test/proxy overrides (leave unset for the real APIs)
# GEMINI_BASE_URL=
# GROQ_BASE_URL=
# OPENROUTER_BASE_URL=

# ---- Research tools (used from Phase 5 onward) -----------------------
TAVILY_API_KEY=
# Optional
FIRECRAWL_API_KEY=

# ---- Auth tuning (optional; defaults shown) --------------------------
# EMAIL_VERIFY_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=60
# SESSION_LIFETIME_HOURS=12
# Days between an account deletion request and removal (the user can cancel meanwhile)
# ACCOUNT_DELETION_GRACE_DAYS=7

# --- Web search and page fetching (Phase 5) ---
# (TAVILY_API_KEY is set above; free key from https://tavily.com. Never commit a real key.)
# TAVILY_BASE_URL=https://api.tavily.com
# TAVILY_TIMEOUT_S=30
# Page fetching limits (SSRF protection itself cannot be switched off)
# FETCH_MAX_BYTES=5242880
# FETCH_TIMEOUT_S=30
# FETCH_MAX_REDIRECTS=5

# --- Agents (Phase 6) ---
# AGENT_MAX_LLM_CALLS=120

# --- Background jobs (Phase 7) ---
# thread = inside the web process (development); celery = separate worker + Redis (production)
# JOB_RUNNER=thread
# JOB_WORKERS=2
# JOB_STALE_AFTER_S=300
# MAX_ACTIVE_JOBS_PER_USER=2
